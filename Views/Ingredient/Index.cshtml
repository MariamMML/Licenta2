@model IEnumerable<Licenta2.Models.ModelIngredient>

@{
    ViewData["Title"] = "Ingredients Index";
}

<h1>Ingredients</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Ingredient</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Quantity</th>
            <th>Weight (grams)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Quantity</td>
                <td>@item.Weight</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IngredientId" class="btn btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.IngredientId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
