@model Licenta2.Models.ModelMealPlanner

@{
    ViewData["Title"] = "Edit Meal Plan";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />

    <div id="meal-plan-entries">
        @foreach (var entry in Model.Entries.OrderBy(e => e.Date))
        {
            <div class="meal-entry">
                <div class="form-group">
                    <label for="dates">Date</label>
                    <input type="date" name="dates[]" class="form-control" value="@entry.Date.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="form-group">
                    <label for="recipeIds">Recipe</label>
                    <select name="recipeIds[]"
                            class="form-control"
                            required
                            asp-items="@(new SelectList(ViewBag.Recipes, "RecipeId", "RecipeName", entry.RecipeId))">
                    </select>
                </div>

                <div class="form-group">
                    <label for="mealTypes">Meal Type</label>
                    <input type="text" name="mealTypes[]" class="form-control" value="@entry.MealType" required />
                </div>
            </div>
        }
    </div>


    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
