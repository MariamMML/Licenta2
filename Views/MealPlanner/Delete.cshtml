@model Licenta2.Models.ModelMealPlanner

@{
    ViewData["Title"] = "Delete Meal Plan";
}

<h2>Delete Meal Plan</h2>
<p>Are you sure you want to delete this meal plan?</p>

<ul>
    @foreach (var entry in Model.Entries.OrderBy(e => e.Date))
    {
        <li>@entry.Date.ToShortDateString() - @entry.MealType: @entry.Recipe?.RecipeName ?? "Unknown Recipe"</li>
    }
</ul>

<form asp-action="Delete" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
