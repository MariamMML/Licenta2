@{
    ViewData["Title"] = "Meal Planner Calendar";
    var daysInMonth = DateTime.DaysInMonth(ViewBag.SelectedYear, ViewBag.SelectedMonth);
    var firstDayOfMonth = new DateTime(ViewBag.SelectedYear, ViewBag.SelectedMonth, 1);
    var mealEntries = ViewBag.MealEntries as List<Licenta2.Models.ModelMealPlannerEntry>;
}

<h1 class="text-center my-4">@ViewBag.SelectedMonth/@ViewBag.SelectedYear Meal Planner</h1>

<!-- Navigation Buttons -->
<div class="d-flex justify-content-between mb-4">
    <a asp-action="Index"
       asp-route-year="@ViewBag.SelectedYear"
       asp-route-month="@(ViewBag.SelectedMonth - 1 > 0 ? ViewBag.SelectedMonth - 1 : 12)"
       class="btn btn-primary">
        &laquo; Previous Month
    </a>
    <a asp-action="Index"
       asp-route-year="@(ViewBag.SelectedMonth == 12 ? ViewBag.SelectedYear + 1 : ViewBag.SelectedYear)"
       asp-route-month="@(ViewBag.SelectedMonth == 12 ? 1 : ViewBag.SelectedMonth + 1)"
       class="btn btn-primary">
        Next Month &raquo;
    </a>
</div>

<!-- Calendar Table -->
<div class="table-responsive">
    <table class="table table-bordered text-center calendar">
        <thead class="table-light">
            <tr>
                <th>Sun</th>
                <th>Mon</th>
                <th>Tue</th>
                <th>Wed</th>
                <th>Thu</th>
                <th>Fri</th>
                <th>Sat</th>
            </tr>
        </thead>
        <tbody>
            @for (var week = 0; week < 6; week++)
            {
                <tr>
                    @for (var day = 0; day < 7; day++)
                    {
                        var dayNumber = week * 7 + day - (int)firstDayOfMonth.DayOfWeek + 1;

                        if (dayNumber < 1 || dayNumber > daysInMonth)
                        {
                            <td class="bg-secondary text-white empty"></td>
                        }
                        else
                        {
                            var date = new DateTime(ViewBag.SelectedYear, ViewBag.SelectedMonth, dayNumber);
                            var hasMeals = mealEntries.Any(e => e.Date.Date == date.Date);

                            <td class="@(hasMeals ? "bg-success text-white has-meals" : "bg-light no-meals")">
                                <a asp-action="DayView"
                                   asp-route-date="@date.ToString("yyyy-MM-dd")"
                                   class="text-decoration-none text-dark">
                                    @dayNumber
                                </a>
                            </td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Custom Styles -->
<style>
    .calendar a {
        display: block;
        width: 100%;
        height: 100%;
        padding: 10px;
        text-align: center;
        border-radius: 5px;
        transition: all 0.2s ease-in-out;
    }
    .calendar a:hover {
            background-color: #f8f9fa;
        color: #0d6efd;
    }
    .empty {
        background-color: #0dadfd;
    }
</style>
