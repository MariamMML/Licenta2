@model IEnumerable<Licenta2.Models.ModelUser>

<h1>Manage Users</h1>

<!-- Button to Redirect to Recipe Statistics -->
<!-- Buttons for Recipe & User Activity Statistics -->
<div class="mt-4">
    <a asp-action="RecipeStatistics" asp-controller="AdminManagement" class="btn btn-info">
        View Recipe Statistics
    </a>

    <a asp-action="UserActivityStatistics" asp-controller="AdminManagement" class="btn btn-success ms-3">
        View User Activity Statistics
    </a>
</div>



<!-- User Management Table -->
<table class="table table-striped mt-5">
    <thead>
        <tr>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    <!-- Assign Admin Button -->
                    <form asp-action="AssignAdmin" asp-controller="AdminManagement" method="post" class="d-inline">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <button type="submit" class="btn btn-primary">Make Administrator</button>
                    </form>

                    <!-- Delete User Button -->
                    <form asp-action="DeleteUser" asp-controller="AdminManagement" method="post" class="d-inline">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mt-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["Error"]</div>
}
