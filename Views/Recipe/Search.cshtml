@model IEnumerable<Licenta2.Models.ModelRecipe>

@{
    ViewData["Title"] = "Search Results";
}

<h2>Search Results</h2>

<form asp-action="Search" method="get">
    <input type="text" name="query" value="@ViewData["CurrentFilter"]" />
    <button type="submit">Search</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Recipe Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var recipe in Model)
        {
            <tr>
                <td>@recipe.RecipeName</td>
                <td>@recipe.Instructions</td>
                <td>
                    <a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.RecipeId">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
