@model Licenta2.Models.ModelRecipe

@{
    ViewData["Title"] = "Recipe Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Recipe Details</h1>

<div>
    <h4>Recipe</h4>
    <hr />
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10">
            <img src="@Url.Content(Model.ImagePath)" alt="Recipe Image" class="img-fluid" style="max-width: 100%; height: auto;" />
        </dd>
    }
    <dl class="row">
        <dt class="col-sm-2">
            Added By
        </dt>
        <dd class="col-sm-10">
            @Model.CreatedBy
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RecipeName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RecipeName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Instructions)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Instructions)
        </dd>

        <dt class="col-sm-2">
            Ingredients
        </dt>
        <dd class="col-sm-10">
            <ul>
                @foreach (var ingredient in Model.Ingredients)
                {
                    <li>@ingredient.Name</li> 
                }
            </ul>
        </dd>

        
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.RecipeId" class="btn btn-warning">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
