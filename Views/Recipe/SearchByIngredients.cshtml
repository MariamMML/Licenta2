@model IEnumerable<Licenta2.Models.ModelRecipe>

@{
    ViewData["Title"] = "Recipes Matching Your Ingredients";
}

<h2 class="mb-4">Recipes Matching Your Ingredients</h2>

<!-- Search Form -->
<form asp-action="SearchByIngredients" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="ingredients" value="@ViewData["CurrentFilter"]" placeholder="Enter ingredients separated by commas" class="form-control" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<!-- Recipes Table -->
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Recipe Name</th>
            <th>Ingredients</th>
            <th>Instructions</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No recipes found with the given ingredients.</td>
            </tr>
        }
        else
        {
            @foreach (var recipe in Model)
            {
                <tr>
                    <td class="align-middle">@recipe.RecipeName</td>
                    <td class="align-middle">
                        <ul class="mb-0">
                            @foreach (var ingredient in recipe.Ingredients)
                            {
                                <li>@ingredient.Name</li> <!-- Assuming each Ingredient has a 'Name' property -->
                            }
                        </ul>
                    </td>
                    <td class="align-middle text-truncate" style="max-width: 300px;">@recipe.Instructions</td>
                    <td class="align-middle">
                        <a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.RecipeId" class="btn btn-info btn-sm">View</a>
                        <a asp-controller="Recipe" asp-action="Edit" asp-route-id="@recipe.RecipeId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-controller="Recipe" asp-action="Delete" asp-route-id="@recipe.RecipeId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
