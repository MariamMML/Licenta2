@model IEnumerable<Licenta2.Models.ModelRecipe>

@{
    ViewData["Title"] = "Recipes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Recipes</h1>

<!-- Search Form -->
<form asp-action="Search" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="query" placeholder="Search recipes..." class="form-control" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<!-- Create New Recipe Button -->
<p>
    <a asp-action="Create" class="btn btn-success">Create New Recipe</a>
</p>

<!-- Recipes Table -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Added By</th>
            <th>Actions</th>
            
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center">No recipes found.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <!-- Recipe Image -->
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" alt="Recipe Image" style="max-height: 100px; max-width: 100px;" />
                        }
                        else
                        {
                            <span>No image</span>
                        }
                    </td>

                    <!-- Recipe Name -->
                    <td>@item.RecipeName</td>

                    <!-- Recipe Description -->
                    <td>
                        @if (string.IsNullOrEmpty(item.Category))
                        {
                            <span>No category assigned.</span>
                        }
                        else
                        {
                            @item.Category
                        }
                    </td>


                    <td>
                        @if (string.IsNullOrEmpty(item.CreatedBy))
                        {
                            <span>Anonynous</span>
                        }
                        else
                        {
                            @item.CreatedBy
                        }
                    </td>


                    <!-- Action Buttons -->
                    <td>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-action="Edit" asp-route-id="@item.RecipeId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.RecipeId" class="btn btn-danger btn-sm">Delete</a>
                        }
                        <a asp-action="Details" asp-route-id="@item.RecipeId" class="btn btn-info btn-sm">Details</a>
                        
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
