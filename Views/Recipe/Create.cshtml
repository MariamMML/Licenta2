@model Licenta2.Models.ModelRecipe

@{
    ViewData["Title"] = "Create Recipe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create Recipe</h1>

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Create">
            <div class="form-group">
                <label asp-for="RecipeName" class="control-label"></label>
                <input asp-for="RecipeName" class="form-control" />
                <span asp-validation-for="RecipeName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Instructions" class="control-label"></label>
                <input asp-for="Instructions" class="form-control" />
                <span asp-validation-for="Instructions" class="text-danger"></span>
            </div>

            <h4>Ingredients</h4>
            <div id="ingredients-container">
                <!-- Dynamically generated ingredient fields will go here -->
            </div>
            <button type="button" onclick="addIngredient()">Add Ingredient</button>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let ingredientIndex = 0;

        function addIngredient() {
            const container = document.getElementById('ingredients-container');
            const ingredientHtml = `
                <div class="form-group">
                    <label>Ingredient Name</label>
                    <input name="Ingredients[${ingredientIndex}].Name" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Quantity</label>
                    <input name="Ingredients[${ingredientIndex}].Quantity" type="number" step="0.01" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Weight</label>
                    <input name="Ingredients[${ingredientIndex}].Weight" class="form-control" />
                </div>
            `;
            container.insertAdjacentHTML('beforeend', ingredientHtml);
            ingredientIndex++;
        }
    </script>
}