@model Licenta2.Models.ModelRecipe

@{
    ViewData["Title"] = "Create Recipe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create Recipe</h1>

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Create" enctype="multipart/form-data">
            <!-- Added enctype for file upload -->
            <div class="form-group">
                <label asp-for="RecipeName" class="control-label"></label>
                <input asp-for="RecipeName" class="form-control" />
                <span asp-validation-for="RecipeName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Instructions" class="control-label"></label>
                <textarea asp-for="Instructions" class="form-control"></textarea>
                <span asp-validation-for="Instructions" class="text-danger"></span>
            </div>

            <!-- Category Dropdown -->
            <div class="form-group">
                <label asp-for="Category" class="control-label">Category</label>
                <select asp-for="Category" class="form-control">
                    <option value="" disabled>Select a category</option>
                    @foreach (var category in ViewBag.Categories as List<string>)
                    {
                        <option value="@category" selected="@(category == Model.Category ? "selected" : null)">@category</option>
                    }
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <!-- Image Upload -->
            <div class="form-group">
                <label>Upload Recipe Image</label>
                <input type="file" name="imageFile" class="form-control" />
            </div>

            <!-- Ingredients Section -->
            <h4>Ingredients</h4>
            <div id="ingredients-container">
                <!-- Dynamically generated ingredient fields will go here -->
            </div>
            <button type="button" onclick="addIngredient()" class="btn btn-secondary">Add Ingredient</button>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        let ingredientIndex = 0;

        // Function to dynamically add ingredient fields
        function addIngredient() {
            const container = document.getElementById('ingredients-container');
            const ingredientHtml = `
                <div class="form-group">
                    <label>Ingredient Name</label>
                    <input name="Ingredients[${ingredientIndex}].Name" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Quantity</label>
                    <input name="Ingredients[${ingredientIndex}].Quantity" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Weight</label>
                    <input name="Ingredients[${ingredientIndex}].Weight" class="form-control" required />
                </div>
                <hr />
            `;
            container.insertAdjacentHTML('beforeend', ingredientHtml);
            ingredientIndex++;
        }
    </script>
}
