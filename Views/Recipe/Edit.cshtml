@model Licenta2.Models.ModelRecipe

@{
    ViewData["Title"] = "Edit Recipe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit Recipe</h1>

<form asp-action="Edit" asp-route-id="@Model.RecipeId" enctype="multipart/form-data">
    <!-- Hidden RecipeId -->
    <input type="hidden" asp-for="RecipeId" />

    <div class="form-group">
        <label asp-for="RecipeName" class="control-label"></label>
        <input asp-for="RecipeName" class="form-control" />
        <span asp-validation-for="RecipeName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Instructions" class="control-label"></label>
        <textarea asp-for="Instructions" class="form-control"></textarea>
        <span asp-validation-for="Instructions" class="text-danger"></span>
    </div>


    <div class="form-group">
        <label asp-for="Category" class="control-label"></label>
        @Html.DropDownListFor(
                 model => model.Category,
                 new SelectList(ViewBag.Categories, Model.Category),
                 "Select a category",
                 new { @class = "form-control" }
                 )
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>



    <div class="form-group">
        <label>Current Image</label>
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div>
                <img src="@Model.ImagePath" alt="Recipe Image" style="max-width: 200px;" />
            </div>
        }
        else
        {
            <p>No image uploaded.</p>
        }

        <label>Upload New Image</label>
        <input type="file" name="imageFile" class="form-control" />
    </div>

    <h4 class="mt-3">Ingredients</h4>
    <hr />
    <div id="ingredients-container">
        @for (int i = 0; i < Model.Ingredients.Count; i++)
        {
            <!-- Use IngredientId to uniquely identify each ingredient -->
            <input type="hidden" name="Ingredients[@i].IngredientId" value="@Model.Ingredients[i].IngredientId" />
            <div class="form-group">
                <label>Ingredient Name</label>
                <input name="Ingredients[@i].Name" value="@Model.Ingredients[i].Name" class="form-control" />
            </div>
            <div class="form-group">
                <label>Quantity</label>
                <input name="Ingredients[@i].Quantity" value="@Model.Ingredients[i].Quantity" type="number" step="0.01" class="form-control" />
            </div>
            <div class="form-group">
                <label>Weight</label>
                <input name="Ingredients[@i].Weight" value="@Model.Ingredients[i].Weight" class="form-control" />
            </div>
        }

    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
